# Cross-chain payroll: one NEAR account pays people on NEAR and moves funds on Base,
# in one reviewable run. Simulate first (nothing is signed), then Review & execute.
load token
load chainsig

# Two Base addresses this NEAR account controls through Chain Signatures.
set $treasury @chainsig:address(base "treasury")
set $savings @chainsig:address(base "savings")
print "treasury on Base:" $treasury
print "savings on Base: " $savings

# Preflight: nothing is signed unless every check passes.
assert @balance > 1near "need 1 NEAR for fees"
assert @token:balance(USDC) >= 1e6 "need 1 USDC on NEAR"
assert @chainsig:balance(base "treasury" ETH) > 0.0001e18 "treasury needs ETH on Base for gas"
assert @chainsig:balance(base "treasury" USDC) >= 1e6 "treasury needs 1 USDC on Base"

# NEAR: pay alice in USDC (her token registration is added in the same transaction) and bob in NEAR.
token:transfer USDC alice.testnet 1 --memo "payroll"
transfer bob.testnet 0.1

# Base: move 1 USDC from treasury to savings, signed by NEAR's MPC network.
chainsig:on base "treasury" (
  exec @token(USDC) "transfer(address,uint256)" $savings 1e6
)
